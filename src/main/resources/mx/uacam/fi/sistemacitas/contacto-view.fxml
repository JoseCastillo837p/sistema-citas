<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uacam.fi.sistemacitas.HelloController">
   <children>
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Formulario de Contacto" />
      <Label text="Medio de contacto preferido:" />

      <ComboBox prefWidth="250.0" promptText="Selecciona un medio">
         <items>
            <FXCollections fx:factory="observableArrayList">
               <String fx:value="En persona" />
               <String fx:value="Por teléfono" />
               <String fx:value="Por correo" />
               <String fx:value="Por redes sociales" />
            </FXCollections>
         </items>
      </ComboBox>

      <Label text="Mensaje:" />
      <TextArea maxWidth="350.0" prefHeight="100.0" prefWidth="350.0" promptText="Escribe un mensaje para saber si la persona acepta o no..." />

      <HBox alignment="CENTER" spacing="20.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onEnviarSolicitudClick" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" text="Enviar Solicitud" />
            <Button mnemonicParsing="false" onAction="#onCancelarContactoClick" text="Cancelar" />
         </children>
      </HBox>
   </children>
</VBox>