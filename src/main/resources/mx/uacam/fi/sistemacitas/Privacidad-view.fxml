<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uacam.fi.sistemacitas.HelloController">
    <children>
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Aviso de Privacidad" />
        <TextArea editable="false" maxWidth="450.0" prefHeight="150.0" prefWidth="450.0" text="La empresa recaba tus datos personales como ubicación y fotografía para mostrar perfiles compatibles. Al continuar, aceptas nuestros términos." wrapText="true" />

        <CheckBox fx:id="chkAcepto" mnemonicParsing="false" onAction="#onCasillaClick" text="He leído y acepto explícitamente el uso de mis datos personales" />

        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#onIrARegistroClick" text="Regresar" />
                <Button fx:id="btnAceptarPrivacidad" disable="true" mnemonicParsing="false" onAction="#onAceptarPrivacidadClick" text="Aceptar y Continuar" />
            </children>
        </HBox>
    </children>
</VBox>