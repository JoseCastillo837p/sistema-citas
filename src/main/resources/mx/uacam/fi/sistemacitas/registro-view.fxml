<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uacam.fi.sistemacitas.HelloController">
    <children>
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Registro de Usuario" />

        <Label text="Correo Electrónico:" />
        <TextField maxWidth="200.0" promptText="ejemplo@uacam.mx" />

        <Label text="Contraseña:" />
        <PasswordField maxWidth="200.0" />

        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#onRegresarALoginClick" prefWidth="90.0" text="Regresar" />
                <Button mnemonicParsing="false" onAction="#onSiguienteClick" prefWidth="90.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" text="Siguiente" />
            </children>
        </HBox>
    </children>
</VBox>