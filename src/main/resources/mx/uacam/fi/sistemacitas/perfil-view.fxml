<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="8.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uacam.fi.sistemacitas.HelloController">
   <children>
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Mi Perfil" />

      <Button mnemonicParsing="false" text="Subir Foto de Perfil" />
      <Label text="Código Postal:" />
      <TextField maxWidth="150.0" />

      <Label text="Biografía / Descripción:" />
      <TextArea maxWidth="400.0" prefHeight="50.0" prefWidth="400.0" />

      <Label text="Mis Intereses / Hobbies:" />
      <TextField maxWidth="400.0" promptText="Ej. programación, lectura, deportes" />

      <Label text="Gustos Musicales:" />
      <TextField maxWidth="400.0" promptText="Ej. rock, pop, electrónica" />

      <HBox alignment="CENTER" spacing="15.0" style="-fx-padding: 10;">
         <children>
            <Button mnemonicParsing="false" onAction="#onRegresarALoginClick" text="Regresar / Cerrar Sesión" />
            <Button mnemonicParsing="false" onAction="#onGuardarPerfilClick" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" text="Guardar Perfil y Continuar" />
         </children>
      </HBox>
   </children>
</VBox>